DATABASE_URL=sqlite:///newen.db
SECRET_KEY=change-me-in-production
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# Token para crear/borrar contenido via API (header X-Admin-Token).
# Si queda vacio, toda escritura devuelve 401. Generalo con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Instagram (Meta app "Newen Sitio Web Oficial").
# App ID y App Secret salen de la consola de Meta > Configuracion de la app > Basica.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# URL publica del sitio, sin barra final. Tiene que coincidir EXACTO con la URI
# de redireccion registrada en Meta, que es <esto>/auth/instagram/callback
PUBLIC_BASE_URL=https://newen-oprl.onrender.com
